# Neon Postgres connection string (neon.tech dashboard > Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Password for /admin (SMS trigger page). Pick something only you know.
ADMIN_PASSWORD=change-me

# Public URL of the deployed site, used to build links inside SMS messages.
# Use http://localhost:3000 for local testing.
SITE_URL=http://localhost:3000

# Shared secret the Google Apps Script sync sends in the X-Sync-Secret header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_SECRET=change-me
